<%= render "govuk_publishing_components/components/layout_for_admin",
  product_name: "Govspeak converter",
  environment: GovukPublishingComponents::AppHelpers::Environment.current_acceptance_environment,
  browser_title: yield(:title) do %>

  <%= render "govuk_publishing_components/components/skip_link" %>

  <div id="wrapper">
    <%= render "govuk_publishing_components/components/layout_header",
    {
      environment:
        GovukPublishingComponents::AppHelpers::Environment.current_acceptance_environment,
      product_name: "Govspeak converter",
      navigation_items: navigation_items,
    } %>

    <main id="main-content" class="govuk-width-container">
      <%= yield %>

      <p class="govuk-body">Govspeak version
        <%= Gem.loaded_specs["govspeak"].version.to_s %></p>
    </main>
  </div>
<% end %>
